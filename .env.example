# Copier ce fichier vers .env puis adapter les valeurs.
# Les valeurs ci-dessous correspondent aux services de docker-compose.yml.

# ── Application ────────────────────────────────────────────────
# URL publique du site (sans barre oblique finale)
APP_URL=http://localhost:3000
# Nom affiché dans l'interface et les emails
NEXT_PUBLIC_NOM_SITE=HLM

# ── Base de données ────────────────────────────────────────────
DATABASE_URL=postgresql://hlm:hlm@localhost:5432/hlm

# ── Authentification (Better Auth) ─────────────────────────────
# Secret de signature des sessions. Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
# Connexion Google (laisser vide pour désactiver le bouton)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Connexion Discord (laisser vide pour désactiver le bouton)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Emails ─────────────────────────────────────────────────────
# En local, Mailpit reçoit tout : http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_EXPEDITEUR="HLM <ne-pas-repondre@localhost>"

# ── Redis (files d'attente, vues) — utilisé à partir de la phase 3 ──
REDIS_URL=redis://localhost:6379

# ── Stockage des images (S3 : RustFS en local, R2 en production) ──
# En local la région doit être us-east-1 ; avec Cloudflare R2, mettre « auto ».
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hlm
S3_ACCESS_KEY_ID=cle-acces-dev
S3_SECRET_ACCESS_KEY=cle-secrete-dev
# URL publique des images (CDN en production). Lue aussi par le navigateur.
NEXT_PUBLIC_URL_IMAGES=http://localhost:9000/hlm

# ── Recherche (Meilisearch) ────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_CLE=cle-maitre-dev-a-changer

# ── Compte administrateur créé par `npm run db:seed` ───────────
ADMIN_EMAIL=admin@example.com
ADMIN_MOT_DE_PASSE=

# ── Mentions légales (obligatoires avant la mise en ligne) ─────
LEGAL_EDITEUR=
LEGAL_STATUT=
LEGAL_ADRESSE=
LEGAL_EMAIL=
LEGAL_DIRECTEUR=
LEGAL_HEBERGEUR=

# ── Synchronisation ────────────────────────────────────────────
# Clé d'API Google pour lire les dossiers Drive partagés (facultatif)
GOOGLE_DRIVE_CLE_API=
