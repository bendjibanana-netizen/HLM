# Configuration de production. Copier vers .env à la racine du projet, puis remplir.
# Générer un secret : openssl rand -base64 32      Générer un mot de passe : openssl rand -hex 24

# ── Domaine ────────────────────────────────────────────────────
# Sans « https:// ». Le sous-domaine images.<domaine> doit aussi pointer vers ce serveur.
DOMAINE=exemple.fr
# Obligatoire : adresse prévenue par Let's Encrypt en cas de problème de certificat
EMAIL_CERTIFICATS=
NEXT_PUBLIC_NOM_SITE=HLM

# ── Secrets (à générer, ne jamais réutiliser ceux du développement) ──
BETTER_AUTH_SECRET=
POSTGRES_MOT_DE_PASSE=
MEILISEARCH_CLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Compte administrateur créé par la commande d'initialisation ─
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE=

# ── Emails (fournisseur SMTP : Brevo, Mailjet, Scaleway, OVH…) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_EXPEDITEUR="HLM <ne-pas-repondre@exemple.fr>"

# ── Connexion Google et Discord (facultatif) ───────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Notifications push (facultatif) : npx web-push generate-vapid-keys ──
NEXT_PUBLIC_VAPID_CLE_PUBLIQUE=
VAPID_CLE_PRIVEE=

# ── Synchronisation Google Drive (facultatif) ──────────────────
GOOGLE_DRIVE_CLE_API=

# ── Mentions légales (obligatoires) ────────────────────────────
LEGAL_EDITEUR=
LEGAL_STATUT=
LEGAL_ADRESSE=
LEGAL_EMAIL=
LEGAL_DIRECTEUR=
LEGAL_HEBERGEUR=

# ── Stockage externe (facultatif) : Cloudflare R2 à la place du stockage local ──
# S3_ENDPOINT=https://<identifiant-de-compte>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=hlm
# NEXT_PUBLIC_URL_IMAGES=https://images.exemple.fr
